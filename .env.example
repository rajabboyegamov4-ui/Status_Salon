# Neon: postgresql://user:pass@host/db?sslmode=require (driver avtomatik asyncpg'ga o'giriladi)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/salon
# production (default): JWT_SECRET 32+ belgi bo'lmasa server ishga tushmaydi, cookie faqat HTTPS orqali.
# Kompyuterda sinash uchun: APP_ENV=development
APP_ENV=production
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Mijozlar salon Telegram boti orqali kiradi va xabar oladi.
# live = haqiqiy Telegram; fake = test (hech narsa yuborilmaydi)
TELEGRAM_BACKEND=live
# Saytning ochiq manzili, bot webhooki shunga ulanadi (masalan https://bron.example.uz)
PUBLIC_URL=
# Bot tokenlarini shifrlash kaliti. Bo'sh bo'lsa JWT_SECRET ishlatiladi:
# unda JWT_SECRET almashsa saqlangan bot tokenlari ochilmay qoladi, botlarni qayta ulash kerak.
TOKEN_KEY=
# SMS ixtiyoriy: none = SMS yo'q (faqat bot); console = kodlar logga; eskiz = haqiqiy SMS
SMS_BACKEND=none
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# Platforma paneli (/platform): salonlarni ulash va obunani uzaytirish.
# Parol xeshi: python -m scripts.hash_password
PLATFORM_LOGIN=
PLATFORM_PASSWORD_HASH=
